# Monthly XLSX archives land here. Never web-accessible — MySQL is the
# permanent store, this folder is a convenience copy, and a leads spreadsheet
# is exactly the kind of file that must never be one guessed URL away.

# Apache 2.4+
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
