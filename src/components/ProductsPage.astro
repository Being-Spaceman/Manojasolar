---
/**
 * Full catalogue page. The homepage Products section shows four category
 * cards with no variant detail and links here for the rest — see brief
 * §4.6: "/products", not "/stock", since nothing here promises live
 * availability.
 */
import Base from "../layouts/Base.astro";
import JsonLd from "./layout/JsonLd.astro";
import { useTranslations, useList } from "../i18n/ui";
import { localePath, type Locale } from "../i18n/config";
import { whatsappLink } from "../data/business";
import { categories, specLine } from "../data/products";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const list = useList(locale);

// Index-aligned with the categories array: panels, inverters, cables, accessories.
const cardCopy = list<{ title: string; body: string }>("products.items");
const crossLang = locale === "mr" ? "en" : "mr";

function waMessageFor(family: string): string {
  return locale === "mr"
    ? `नमस्कार, मला ${family} बद्दल विचारायचं आहे.`
    : `Hello, I would like to ask about ${family}.`;
}
---

<Base
  locale={locale}
  title={t("meta.products.title")}
  description={t("meta.products.description")}
  path="/products"
>
  <JsonLd slot="head" locale={locale} />

  <section class="page">
    <div class="wrap intro">
      <p class="kicker">{t("productsPage.kicker")}</p>
      <h1 class="headline">{t("productsPage.headline")}</h1>
      <p class="cross" lang={crossLang}>{t("productsPage.cross")}</p>
      <p class="note">{t("productsPage.note")}</p>
    </div>

    {
      categories.map((cat, i) => (
        <div class="wrap cat" id={cat.id}>
          <h2 class="cat-title">{cardCopy[i].title}</h2>
          {cat.id === "inverters" && <p class="cat-note">{t("productsPage.inverterNote")}</p>}

          <ul class="items">
            {cat.items.map((item) => (
              <li class="item">
                <div class="item-text">
                  <p class="family">{item.family}</p>
                  {specLine(item) && <p class="spec">{specLine(item)}</p>}
                </div>
                <a
                  class="ask"
                  href={whatsappLink(waMessageFor(item.family))}
                  target="_blank"
                  rel="noopener"
                  data-cta={`products-page-whatsapp-${cat.id}`}
                >
                  {t("productsPage.cta")}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div class="wrap back">
      <a href={localePath("/", locale)} class="back-link">{t("productsPage.backLabel")}</a>
    </div>
  </section>
</Base>

<style>
  .page {
    background: var(--color-bg);
    padding-block: 30px 50px;
  }

  .intro {
    max-width: 56rem;
  }

  .kicker {
    color: var(--color-micro);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .headline {
    color: var(--color-forest);
    font-size: var(--text-h2);
    font-weight: 800;
    line-height: 1.35;
    margin-top: 9px;
  }

  .cross {
    color: var(--color-body);
    font-size: var(--text-body);
    line-height: 1.6;
    margin-top: 6px;
  }

  .note {
    color: var(--color-muted);
    font-size: var(--text-small);
    margin-top: 10px;
  }

  .cat {
    border-top: 1px solid var(--color-hair);
    margin-top: 28px;
    max-width: 56rem;
    padding-top: 24px;
  }

  .cat-title {
    color: var(--color-forest);
    font-size: var(--text-h3);
    font-weight: 800;
  }

  .cat-note {
    color: var(--color-muted);
    font-size: var(--text-small);
    line-height: 1.5;
    margin-top: 6px;
    max-width: 52ch;
  }

  .items {
    display: flex;
    flex-direction: column;
    gap: 12px;
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
  }

  .item {
    align-items: center;
    background: #fff;
    border: 1px solid var(--color-edge);
    display: flex;
    flex-wrap: wrap;
    gap: 10px 16px;
    justify-content: space-between;
    padding: 14px 16px;
  }

  .item-text {
    min-width: 0;
  }

  .family {
    color: var(--color-ink);
    font-size: var(--text-body);
    font-weight: 700;
  }

  .spec {
    color: var(--color-muted);
    font-size: var(--text-small);
    line-height: 1.45;
    margin-top: 2px;
  }

  .ask {
    align-items: center;
    border: 2px solid var(--color-green);
    color: var(--color-green);
    display: flex;
    flex: none;
    font-size: var(--text-cta-sm);
    font-weight: 800;
    justify-content: center;
    min-height: 44px;
    padding-inline: 16px;
    text-align: center;
  }

  .back {
    margin-top: 34px;
    max-width: 56rem;
  }

  .back-link {
    box-shadow: inset 0 -1px 0 0 var(--color-field);
    color: var(--color-green);
    display: inline-block;
    font-weight: 600;
  }

  @media (min-width: 64rem) {
    .page {
      padding-block: 56px 80px;
    }
    .headline {
      font-size: var(--text-h1-lg);
    }
    .item {
      flex-wrap: nowrap;
    }
    .ask {
      min-width: 180px;
    }
  }
</style>
