---
import { Picture } from "astro:assets";
import { useTranslations, useList } from "../../i18n/ui";
import { type Locale } from "../../i18n/config";
import { BUSINESS, whatsappLink, telLink } from "../../data/business";
import { HERO_IMAGE } from "../../data/media";

/**
 * Full-bleed background now, at every breakpoint — sizes is always 100vw.
 * Kept as exported constants so HeroPreload.astro requests the identical
 * transform and never double-downloads.
 */
export const HERO_WIDTHS = [640, 960, 1440, 1920];
export const HERO_SIZES = "100vw";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const list = useList(locale);

const stats = list<{ value: string; label: string }>("hero.stats");

/** Split "15,000+" into a numeric target (15000) and its trailing suffix (+),
 *  so the count-up script has something to animate toward. */
function countupParts(value: string) {
  return {
    target: value.replace(/[^\d]/g, ""),
    suffix: value.replace(/[\d,]/g, ""),
  };
}

// [HERO] tags the incoming chat so a rep can tell which CTA sent it —
// see the source-tagging convention documented for every WhatsApp CTA.
const waMessage =
  locale === "mr"
    ? "नमस्कार, मला साठ्याबद्दल विचारायचं आहे. [HERO]"
    : "Hello, I would like to check stock availability. [HERO]";
---

<section class="hero">
  {/*
    Full-bleed background. TODO(MNJ): licensed stock placeholder — see
    BUILD-REPORT.md — will be replaced with the owner's own godown
    photography via the HERO_IMAGE constant in src/data/media.ts.
  */}
  <Picture
    class="bg"
    src={HERO_IMAGE}
    alt=""
    aria-hidden="true"
    width={1920}
    widths={HERO_WIDTHS}
    sizes={HERO_SIZES}
    formats={["webp"]}
    fallbackFormat="jpg"
    quality={50}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />

  {/* ink 70% at the bottom fading to 20% at the top — keeps white text
      legible against the photo whatever it ends up being. */}
  <div class="scrim" aria-hidden="true"></div>

  <div class="wrap content">
    <h1 class="headline" lang={locale} set:html={t("hero.headline")} />
  </div>

  <div class="wrap card-row">
    <div class="card">
      <p class="eyebrow">{t("hero.cardEyebrow")}</p>

      <dl class="stats">
        {
          stats.map((s) => {
            const { target, suffix } = countupParts(s.value);
            return (
              <div class="stat">
                <dt class="stat-value" data-countup={target} data-suffix={suffix}>
                  {s.value}
                </dt>
                <dd class="stat-label">{s.label}</dd>
              </div>
            );
          })
        }
      </dl>

      <a
        class="cta"
        href={whatsappLink(waMessage)}
        target="_blank"
        rel="noopener"
        data-cta="hero-whatsapp"
      >
        {t("hero.cta")}
      </a>

      <a class="call" href={telLink()} data-cta="hero-call">
        {t("hero.callPrefix")} · {BUSINESS.phoneDisplay}
      </a>
    </div>
  </div>

</section>

{/*
  Count from zero to the real figure once, on first scroll into view. The real
  figure is already server-rendered above so nothing breaks without JS or
  under reduced motion — this script only ever animates toward the number
  that is already correct.
*/}
<script>
  const els = document.querySelectorAll<HTMLElement>("[data-countup]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (els.length && !reduced && "IntersectionObserver" in window) {
    els.forEach((el) => {
      el.textContent = "0" + (el.dataset.suffix ?? "");
    });

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          io.unobserve(el);

          const target = parseInt(el.dataset.countup ?? "0", 10);
          const suffix = el.dataset.suffix ?? "";
          const duration = 1200;
          const start = performance.now();

          function tick(now: number) {
            const p = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - p, 3); // ease-out
            const value = Math.round(target * eased);
            el.textContent = value.toLocaleString("en-IN") + suffix;
            if (p < 1) requestAnimationFrame(tick);
          }
          requestAnimationFrame(tick);
        }
      },
      { threshold: 0.4 },
    );

    els.forEach((el) => io.observe(el));
  }
</script>

{/*
  Tells the header (rendered outside this component, in Base.astro) when the
  hero has scrolled past so it can switch from translucent to solid. Observes
  the hero section itself rather than a thin sentinel line — isIntersecting
  is unambiguous this way (true while any part of the hero is still on
  screen, false only once the whole section has cleared the viewport), same
  IntersectionObserver approach StickyCta.astro already uses elsewhere.
*/}
<script>
  const hero = document.querySelector<HTMLElement>(".hero");
  const header = document.querySelector<HTMLElement>("[data-floating-header]");

  if (hero && header && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      ([entry]) => {
        header.classList.toggle("is-solid", !entry.isIntersecting);
      },
      { rootMargin: "0px 0px -64px 0px" },
    );
    io.observe(hero);
  }
</script>

<style>
  .hero {
    background: var(--color-ink);
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    position: relative;
  }

  /* Picture wraps the <img> in a <picture>; display:contents lets the <img>
     itself take the absolute-fill styling below instead of an unstyled
     wrapper box sitting in between. */
  .hero > picture {
    display: contents;
  }

  .bg {
    height: 100%;
    inset: 0;
    object-fit: cover;
    /* Slightly low focal point so the panel rows (not empty sky/water) read
       within the crop on both a short mobile viewport and a wide desktop one. */
    object-position: 50% 65%;
    position: absolute;
    width: 100%;
    z-index: 0;
  }

  .scrim {
    background: linear-gradient(
      to top,
      rgb(11 31 23 / 0.8) 0%,
      rgb(11 31 23 / 0.48) 100%
    );
    inset: 0;
    position: absolute;
    z-index: 1;
  }

  .content {
    display: flex;
    flex: 1;
    align-items: flex-end;
    padding-block: 88px 24px;
    position: relative;
    z-index: 2;
  }

  .headline {
    color: #fff;
    font-size: clamp(3rem, 1.67rem + 5.93vw, 7rem);
    font-weight: 800;
    line-height: 0.95;
    text-wrap: balance;
    /* Belt-and-braces on top of the scrim: the scrim alone can't guarantee AA
       against an unknown future replacement photo, so the text carries its
       own contrast regardless of what's behind it. Cheap — a per-glyph
       shadow on a few large characters, not a full-surface blur. */
    text-shadow: 0 2px 20px rgb(0 0 0 / 0.55), 0 1px 4px rgb(0 0 0 / 0.7);
  }
  /* Devanagari needs more line-height than Latin at this size, or the matras
     on "साठा"/"त्याच" collide with the शिरोरेखा of the line below at 7rem —
     never letterspaced either (global :lang(mr) rule already zeroes that). */
  .headline:lang(mr) {
    line-height: 1.15;
  }
  .headline:lang(en) {
    letter-spacing: -0.02em;
  }

  .card-row {
    padding-bottom: 16px;
    position: relative;
    z-index: 2;
  }

  /* Solid ink, not glass — a blur here is a real GPU cost on mid-range
     Android for an effect nobody asked for. Square corners, per --radius-none. */
  .card {
    background: rgb(11 31 23 / 0.92);
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px;
  }

  .eyebrow {
    color: var(--color-amber);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .stats {
    display: grid;
    /* Fixed at three columns always — labels wrap inside their own column
       instead of the columns wrapping to a second row. */
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin: 0;
  }
  .stat {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .stat-value {
    color: var(--color-amber);
    font-size: var(--text-stat);
    font-weight: 800;
  }
  .stat-label {
    color: rgb(255 255 255 / 0.75);
    font-size: 11px;
    line-height: 1.3;
    margin: 0;
  }

  .cta {
    align-items: center;
    background: var(--color-amber);
    color: var(--color-ink);
    display: flex;
    font-size: 18.5px;
    font-weight: 800;
    justify-content: center;
    margin-top: 2px;
    min-height: 58px;
    padding-inline: 16px;
    text-align: center;
  }

  .call {
    align-items: center;
    color: #fff;
    display: flex;
    flex-wrap: wrap;
    font-size: var(--text-lead);
    font-weight: 700;
    gap: 4px 8px;
    justify-content: center;
    min-height: 44px;
    text-align: center;
  }

  @media (min-width: 64rem) {
    .content {
      align-items: center;
      justify-content: center;
      padding-block: 96px 24px;
    }
    .headline {
      margin-inline: auto;
      max-width: 20ch;
      text-align: center;
    }
    .card-row {
      padding-bottom: 24px;
    }
    .card {
      /* Centred under the centred headline, not bottom-left — the two read as
         one stacked composition rather than two unrelated blocks. */
      margin-inline: auto;
      max-width: 620px;
      padding: 26px 32px;
    }
    /* The card's type is set for a narrow mobile column; at desktop it sits
       under a 7rem headline and needs to scale up with it or it reads as an
       afterthought. */
    .stat-value {
      font-size: 1.75rem;
    }
    .stat-label {
      font-size: 12.5px;
    }
  }
</style>
