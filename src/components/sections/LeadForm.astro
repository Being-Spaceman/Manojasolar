---
import { useTranslations, useList } from "../../i18n/ui";
import { localePath, type Locale } from "../../i18n/config";
import { whatsappLink } from "../../data/business";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const list = useList(locale);

const productOptions = list<{ value: string; label: string }>("form.business.productOptions");
const roofOptions = list<{ value: string; label: string }>("form.individual.roofOptions");
const crossLang = locale === "mr" ? "en" : "mr";
const thankYouPath = localePath("/thank-you", locale);

const waMessage =
  locale === "mr"
    ? "नमस्कार, मला चौकशी करायची आहे."
    : "Hello, I would like to make an enquiry.";

/* Error strings render into a data attribute so the client script can pick the right
   message in the active language without shipping a second copy of the dict. Keys are
   canonical (audience-independent) — the client maps them to whichever fieldset is
   currently visible. */
const errors = {
  typeRequired: t("form.errors.typeRequired"),
  firmNameRequired: t("form.errors.firmNameRequired"),
  contactNameRequired: t("form.errors.contactNameRequired"),
  mobileRequired: t("form.errors.mobileRequired"),
  mobileInvalid: t("form.errors.mobileInvalid"),
  cityRequired: t("form.errors.cityRequired"),
  gstinInvalid: t("form.errors.gstinInvalid"),
  consentRequired: t("form.errors.consentRequired"),
  network: t("form.errors.network"),
};
---

<section class="lead" id="contact-form">
  <div class="wrap">
    <div class="card">
      <div class="head">
        <p class="kicker">{t("form.kicker")}</p>
        <h2 class="headline">{t("form.headline")}</h2>
        <p class="cross" lang={crossLang}>{t("form.cross")}</p>
      </div>

      {/*
        Progressive enhancement is mandatory here: with JS off, BOTH fieldsets below
        render visible and neither is HTML `required`, so either one can be filled in
        and posted straight to /api/lead.php, which validates server-side against
        whichever `lead_type` was actually selected. JS (below) hides the fieldset
        that was not chosen, adds `required` to the one that was, and upgrades the
        submit to a fetch() with inline errors.
      */}
      <form
        class="form"
        id="lead-form"
        method="post"
        action="/api/lead.php"
        novalidate
        data-thanks={thankYouPath}
        data-locale={locale}
        data-source={`/${locale === "mr" ? "" : locale}`}
        data-err={JSON.stringify(errors)}
      >
        {/*
          No-JS fallback target: the browser posts this form as a plain navigation,
          so lead.php cannot rely on the JS-only `Accept: application/json` header to
          know where "success" should go. This hidden field tells it directly.
        */}
        <input type="hidden" name="thanks_path" value={thankYouPath} />

        <fieldset class="type">
          <legend class="sr-only">{t("form.typeLegend")}</legend>
          <label class="type-card">
            <input type="radio" name="lead_type" value="business" id="lf-type-business" />
            <span>{t("form.typeBusiness")}</span>
          </label>
          <label class="type-card">
            <input type="radio" name="lead_type" value="individual" id="lf-type-individual" />
            <span>{t("form.typeIndividual")}</span>
          </label>
        </fieldset>
        <p class="err" id="err-lead_type" role="alert" hidden></p>

        {/* --- B2B fieldset --- */}
        <fieldset class="subform" id="lf-business" data-audience="business">
          <legend class="sr-only">{t("form.business.legend")}</legend>

          <div class="field">
            <label for="lf-biz-firm">{t("form.business.firmName")}</label>
            <input
              id="lf-biz-firm"
              name="biz_firm_name"
              type="text"
              autocomplete="organization"
              enterkeyhint="next"
              placeholder={t("form.business.firmNamePlaceholder")}
              aria-describedby="err-firm_name"
            />
            <p class="err" id="err-firm_name" role="alert" hidden></p>
          </div>

          <div class="field">
            <label for="lf-biz-contact">{t("form.business.contactName")}</label>
            <input
              id="lf-biz-contact"
              name="biz_contact_name"
              type="text"
              autocomplete="name"
              enterkeyhint="next"
              placeholder={t("form.business.contactNamePlaceholder")}
              aria-describedby="err-contact_name-business"
            />
            <p class="err" id="err-contact_name-business" role="alert" hidden></p>
          </div>

          <div class="field">
            <label for="lf-biz-mobile">{t("form.business.mobile")}</label>
            <div class="combo">
              <span class="prefix" aria-hidden="true">{t("form.business.mobilePrefix")}</span>
              <input
                id="lf-biz-mobile"
                name="biz_mobile"
                type="tel"
                inputmode="numeric"
                autocomplete="tel-national"
                enterkeyhint="next"
                maxlength="10"
                placeholder={t("form.business.mobilePlaceholder")}
                aria-describedby="err-mobile-business"
              />
            </div>
            <p class="err" id="err-mobile-business" role="alert" hidden></p>
          </div>

          <div class="field">
            <label for="lf-biz-city">{t("form.business.city")}</label>
            <input
              id="lf-biz-city"
              name="biz_city"
              type="text"
              autocomplete="address-level2"
              enterkeyhint="next"
              placeholder={t("form.business.cityPlaceholder")}
              aria-describedby="err-city"
            />
            <p class="err" id="err-city" role="alert" hidden></p>
          </div>

          <div class="field">
            <span class="group-label">{t("form.business.productsLabel")}</span>
            <div class="checks">
              {productOptions.map((o) => (
                <label class="check">
                  <input type="checkbox" name="biz_products[]" value={o.value} />
                  <span>{o.label}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="field">
            <label for="lf-biz-gstin">{t("form.business.gstin")}</label>
            <input
              id="lf-biz-gstin"
              name="biz_gstin"
              type="text"
              autocomplete="off"
              enterkeyhint="next"
              placeholder={t("form.business.gstinPlaceholder")}
              aria-describedby="err-gstin"
            />
            <p class="err" id="err-gstin" role="alert" hidden></p>
          </div>

          <div class="field">
            <label for="lf-biz-message">{t("form.business.message")}</label>
            <textarea
              id="lf-biz-message"
              name="biz_message"
              rows="3"
              placeholder={t("form.business.messagePlaceholder")}
            ></textarea>
          </div>
        </fieldset>

        {/* --- B2C fieldset --- */}
        <fieldset class="subform" id="lf-individual" data-audience="individual">
          <legend class="sr-only">{t("form.individual.legend")}</legend>

          <div class="field">
            <label for="lf-ind-name">{t("form.individual.name")}</label>
            <input
              id="lf-ind-name"
              name="ind_contact_name"
              type="text"
              autocomplete="name"
              enterkeyhint="next"
              placeholder={t("form.individual.namePlaceholder")}
              aria-describedby="err-contact_name-individual"
            />
            <p class="err" id="err-contact_name-individual" role="alert" hidden></p>
          </div>

          <div class="field">
            <label for="lf-ind-mobile">{t("form.individual.mobile")}</label>
            <div class="combo">
              <span class="prefix" aria-hidden="true">{t("form.individual.mobilePrefix")}</span>
              <input
                id="lf-ind-mobile"
                name="ind_mobile"
                type="tel"
                inputmode="numeric"
                autocomplete="tel-national"
                enterkeyhint="next"
                maxlength="10"
                placeholder={t("form.individual.mobilePlaceholder")}
                aria-describedby="err-mobile-individual"
              />
            </div>
            <p class="err" id="err-mobile-individual" role="alert" hidden></p>
          </div>

          <div class="field">
            <label for="lf-ind-bill">{t("form.individual.bill")}</label>
            <div class="combo">
              <span class="prefix" aria-hidden="true">{t("form.individual.billPrefix")}</span>
              <input
                id="lf-ind-bill"
                name="ind_bill_amount"
                type="text"
                inputmode="numeric"
                enterkeyhint="next"
                maxlength="7"
                placeholder={t("form.individual.billPlaceholder")}
              />
            </div>
          </div>

          <div class="field">
            <label for="lf-ind-usage">{t("form.individual.usage")}</label>
            <input
              id="lf-ind-usage"
              name="ind_usage_units"
              type="text"
              inputmode="numeric"
              enterkeyhint="next"
              maxlength="6"
              placeholder={t("form.individual.usagePlaceholder")}
            />
          </div>

          <div class="field">
            <label for="lf-ind-roof">{t("form.individual.roof")}</label>
            <select id="lf-ind-roof" name="ind_roof_type">
              <option value="">{t("form.individual.roofSelect")}</option>
              {roofOptions.map((o) => <option value={o.value}>{o.label}</option>)}
            </select>
          </div>
        </fieldset>

        {/*
          Honeypot. Real people never fill this in because they never see it;
          bots fill every field they find. Not `display:none` — some bots skip
          hidden fields — and aria-hidden + tabindex keep it away from AT.
        */}
        <div class="hp" aria-hidden="true">
          <label for="lf-website">Website</label>
          <input
            id="lf-website"
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <label class="consent">
          <input type="checkbox" name="consent" value="yes" id="lf-consent" aria-describedby="err-consent" />
          <span>{t("form.consent")}</span>
        </label>
        <p class="err" id="err-consent" role="alert" hidden></p>

        <button
          class="submit"
          type="submit"
          data-cta="lead-submit"
          data-label={t("form.submit")}
          data-label-busy={t("form.submitting")}
        >
          <span class="label">{t("form.submit")}</span>
          <span class="spinner" aria-hidden="true"></span>
        </button>

        <p class="err form-err" id="err-form" role="alert" hidden></p>

        <p class="note">{t("form.note")}</p>

        <a
          class="alt"
          href={whatsappLink(waMessage)}
          target="_blank"
          rel="noopener"
          data-cta="lead-whatsapp"
        >
          {t("form.orWhatsApp")}
        </a>
      </form>
    </div>
  </div>
</section>

<style>
  .lead {
    background: var(--color-paper);
    padding-block: 34px;
  }

  .card {
    background: #fff;
    border: 1px solid var(--color-edge);
    padding: 22px 18px 24px;
  }

  .kicker {
    color: var(--color-micro);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .headline {
    color: var(--color-forest);
    font-size: var(--text-h3);
    font-weight: 800;
    line-height: 1.35;
    margin-top: 8px;
  }

  .cross {
    color: var(--color-body);
    font-size: var(--text-body);
    line-height: 1.6;
    margin-top: 6px;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 22px;
  }

  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }

  /* Two large tappable cards, no default selection. */
  .type {
    display: grid;
    gap: 10px;
  }
  .type-card {
    align-items: center;
    border: 1.5px solid var(--color-field);
    cursor: pointer;
    display: flex;
    font-size: var(--text-base);
    font-weight: 600;
    gap: 10px;
    min-height: 56px;
    padding: 12px 14px;
  }
  .type-card input {
    accent-color: var(--color-green);
    flex: none;
    height: 20px;
    width: 20px;
  }
  .type-card:has(input:checked) {
    background: var(--color-mist);
    border-color: var(--color-green);
  }
  .type-card:has(input:focus-visible) {
    outline: 2px solid var(--color-green);
    outline-offset: 2px;
  }

  .subform {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  label,
  .group-label {
    color: var(--color-muted);
    font-size: var(--text-small);
    font-weight: 600;
  }

  input,
  select,
  textarea {
    background: #fff;
    border: 1.5px solid var(--color-field);
    border-radius: 0;
    color: var(--color-ink);
    font-family: inherit;
    /* 16px minimum: anything smaller makes iOS Safari zoom on focus. */
    font-size: var(--text-base);
    padding: 13px;
    width: 100%;
  }
  input,
  select {
    min-height: 52px;
    padding: 0 13px;
  }

  input::placeholder,
  textarea::placeholder {
    color: #9a9ea2;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--color-green);
  }

  /* The combo puts a fixed prefix (+91, ₹) against the field so the user does not
     type it and the validator does not have to strip it. */
  .combo {
    display: flex;
  }
  .prefix {
    align-items: center;
    background: var(--color-mist);
    border: 1.5px solid var(--color-field);
    border-right: 0;
    color: var(--color-forest);
    display: flex;
    flex: none;
    font-size: var(--text-base);
    font-weight: 600;
    padding-inline: 12px;
  }
  .combo input {
    border-left: 0;
  }

  .checks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
  }
  .check {
    align-items: center;
    color: var(--color-ink);
    display: flex;
    font-size: var(--text-small);
    font-weight: 600;
    gap: 7px;
  }
  .check input {
    accent-color: var(--color-green);
    flex: none;
    height: 18px;
    width: 18px;
  }

  .consent {
    align-items: flex-start;
    color: var(--color-ink);
    display: flex;
    font-size: var(--text-small);
    font-weight: 600;
    gap: 10px;
  }
  .consent input {
    accent-color: var(--color-green);
    flex: none;
    height: 20px;
    margin-top: 1px;
    width: 20px;
  }

  /* Invalid state uses a red border and forest text. Red on a border is the one
     sanctioned exception to "red is CTA only" — an error has to read as an error,
     and it never appears at the same time as an idle CTA in the same field group. */
  input[aria-invalid="true"],
  select[aria-invalid="true"] {
    border-color: var(--color-red);
  }

  .err {
    color: var(--color-red);
    font-size: var(--text-small);
    font-weight: 600;
    line-height: 1.45;
  }
  .form-err {
    margin-top: -6px;
  }

  /* Off-screen rather than display:none, so bots that skip hidden inputs still bite. */
  .hp {
    height: 1px;
    left: -9999px;
    overflow: hidden;
    position: absolute;
    width: 1px;
  }

  .submit {
    align-items: center;
    background: var(--color-red);
    border: 0;
    border-radius: 0;
    color: #fff;
    cursor: pointer;
    display: flex;
    font-family: inherit;
    font-size: var(--text-cta);
    font-weight: 800;
    gap: 10px;
    justify-content: center;
    min-height: 56px;
    padding-inline: 20px;
    text-align: center;
    width: 100%;
  }
  .submit[data-busy="true"] {
    cursor: progress;
    /* Deliberately not greyed out: on a slow connection a disabled-looking button
       reads as "it failed". It stays full strength and gains a spinner. */
  }

  .spinner {
    animation: spin 0.7s linear infinite;
    border: 2.5px solid rgb(255 255 255 / 0.35);
    border-top-color: #fff;
    display: none;
    height: 18px;
    width: 18px;
  }
  .submit[data-busy="true"] .spinner {
    display: block;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .spinner {
      animation-duration: 2s;
    }
  }

  .note {
    color: var(--color-muted);
    font-size: 13.5px;
    line-height: 1.5;
  }

  .alt {
    align-items: center;
    border: 2px solid var(--color-green);
    color: var(--color-green);
    display: flex;
    font-size: var(--text-cta-sm);
    font-weight: 800;
    justify-content: center;
    min-height: 52px;
    text-align: center;
  }

  @media (min-width: 64rem) {
    .lead {
      padding-block: 64px;
    }
    .card {
      display: grid;
      gap: 0 56px;
      grid-template-columns: 1fr 1fr;
      padding: 40px;
    }
    .headline {
      font-size: var(--text-h2-lg);
    }
    .form {
      margin-top: 0;
    }
    .type {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  // Validation, audience toggle, submit state and redirect. Vanilla, no framework —
  // this page runs on a mid-range Android on 4G and the form is the only thing that
  // needs JS. None of this is load-bearing: with JS off, both fieldsets below stay
  // visible, nothing here runs, and the browser posts the form to /api/lead.php
  // directly, which validates server-side against whichever lead_type was submitted.
  const form = document.getElementById("lead-form") as HTMLFormElement | null;

  if (form) {
    const msg = JSON.parse(form.dataset.err ?? "{}") as Record<string, string>;
    const thanks = form.dataset.thanks ?? "/thank-you";
    const submit = form.querySelector("button[type=submit]") as HTMLButtonElement;
    const submitLabel = submit.querySelector(".label") as HTMLElement;
    const formErr = document.getElementById("err-form") as HTMLElement;

    const bizFieldset = document.getElementById("lf-business") as HTMLFieldSetElement;
    const indFieldset = document.getElementById("lf-individual") as HTMLFieldSetElement;
    const typeRadios = Array.from(
      form.querySelectorAll<HTMLInputElement>('input[name="lead_type"]'),
    );

    // Canonical field name -> the actual DOM input name for each audience, and the
    // id of the box its error message renders into. Lets server + client share one
    // set of error keys even though the two fieldsets use different `name`s to avoid
    // colliding when both are present in a no-JS submission.
    const FIELD_MAP: Record<string, Record<string, { input: string; err: string }>> = {
      business: {
        firm_name: { input: "biz_firm_name", err: "err-firm_name" },
        contact_name: { input: "biz_contact_name", err: "err-contact_name-business" },
        mobile: { input: "biz_mobile", err: "err-mobile-business" },
        city: { input: "biz_city", err: "err-city" },
        gstin: { input: "biz_gstin", err: "err-gstin" },
      },
      individual: {
        contact_name: { input: "ind_contact_name", err: "err-contact_name-individual" },
        mobile: { input: "ind_mobile", err: "err-mobile-individual" },
      },
    };

    // No default selection: both fieldsets start hidden until a choice is made —
    // the no-JS markup shows both, so this only ever runs once JS is confirmed live.
    bizFieldset.hidden = true;
    indFieldset.hidden = true;
    setRequired(bizFieldset, false);
    setRequired(indFieldset, false);

    function setRequired(fieldset: HTMLFieldSetElement, required: boolean) {
      fieldset.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input, select").forEach((el) => {
        if (el.type === "checkbox") return;
        // Only the fields the brief marks required get the attribute; optional
        // fields (GSTIN, message, bill, usage, roof) never become required.
        if (el.dataset.optional === "true") return;
        el.required = required;
      });
    }

    function activeAudience(): "business" | "individual" | null {
      const checked = typeRadios.find((r) => r.checked);
      return (checked?.value as "business" | "individual" | undefined) ?? null;
    }

    function showAudience(audience: "business" | "individual" | null) {
      bizFieldset.hidden = audience !== "business";
      indFieldset.hidden = audience !== "individual";
      setRequired(bizFieldset, audience === "business");
      setRequired(indFieldset, audience === "individual");
    }

    typeRadios.forEach((r) => r.addEventListener("change", () => showAudience(activeAudience())));

    // Mark the optional fields so setRequired() above skips them even inside the
    // active fieldset.
    ["lf-biz-gstin", "lf-biz-message"].forEach((id) => {
      document.getElementById(id)?.setAttribute("data-optional", "true");
    });
    ["lf-ind-bill", "lf-ind-usage", "lf-ind-roof"].forEach((id) => {
      document.getElementById(id)?.setAttribute("data-optional", "true");
    });

    const showError = (boxId: string, inputEl: HTMLElement | null, text: string | null) => {
      const box = document.getElementById(boxId);
      if (!box) return;
      if (text) {
        inputEl?.setAttribute("aria-invalid", "true");
        box.textContent = text;
        box.hidden = false;
      } else {
        inputEl?.removeAttribute("aria-invalid");
        box.textContent = "";
        box.hidden = true;
      }
    };

    // Indian mobile: 10 digits, first must be 6-9.
    const PHONE = /^[6-9]\d{9}$/;
    const GSTIN = /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/;

    const byId = (id: string) => document.getElementById(id) as HTMLInputElement | null;

    const validate = (): boolean => {
      let ok = true;
      let firstBad: HTMLElement | null = null;
      const fail = (el: HTMLElement | null, boxId: string, text: string) => {
        showError(boxId, el, text);
        ok = false;
        firstBad ??= el;
      };

      const audience = activeAudience();
      if (!audience) {
        fail(null, "err-lead_type", msg.typeRequired);
      } else {
        showError("err-lead_type", null, null);

        if (audience === "business") {
          const firm = byId("lf-biz-firm");
          if (!firm?.value.trim()) fail(firm, "err-firm_name", msg.firmNameRequired);
          else showError("err-firm_name", firm, null);

          const contact = byId("lf-biz-contact");
          if (!contact?.value.trim())
            fail(contact, "err-contact_name-business", msg.contactNameRequired);
          else showError("err-contact_name-business", contact, null);

          const mobile = byId("lf-biz-mobile");
          const digits = (mobile?.value ?? "").replace(/\D/g, "");
          if (!digits) fail(mobile, "err-mobile-business", msg.mobileRequired);
          else if (!PHONE.test(digits)) fail(mobile, "err-mobile-business", msg.mobileInvalid);
          else showError("err-mobile-business", mobile, null);

          const city = byId("lf-biz-city");
          if (!city?.value.trim()) fail(city, "err-city", msg.cityRequired);
          else showError("err-city", city, null);

          const gstin = byId("lf-biz-gstin");
          const gstinVal = (gstin?.value ?? "").trim().toUpperCase();
          if (gstinVal && !GSTIN.test(gstinVal)) fail(gstin, "err-gstin", msg.gstinInvalid);
          else showError("err-gstin", gstin, null);
        } else {
          const name = byId("lf-ind-name");
          if (!name?.value.trim())
            fail(name, "err-contact_name-individual", msg.contactNameRequired);
          else showError("err-contact_name-individual", name, null);

          const mobile = byId("lf-ind-mobile");
          const digits = (mobile?.value ?? "").replace(/\D/g, "");
          if (!digits) fail(mobile, "err-mobile-individual", msg.mobileRequired);
          else if (!PHONE.test(digits)) fail(mobile, "err-mobile-individual", msg.mobileInvalid);
          else showError("err-mobile-individual", mobile, null);
        }
      }

      const consent = byId("lf-consent");
      if (!consent?.checked) fail(consent, "err-consent", msg.consentRequired);
      else showError("err-consent", consent, null);

      firstBad?.focus();
      return ok;
    };

    // Clear a field's error as soon as the user starts fixing it.
    form.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input, select").forEach((el) => {
      el.addEventListener("input", () => {
        if (el.getAttribute("aria-invalid")) el.removeAttribute("aria-invalid");
      });
    });

    // Phone fields accept digits only, live.
    ["lf-biz-mobile", "lf-ind-mobile", "lf-ind-bill", "lf-ind-usage"].forEach((id) => {
      const el = byId(id);
      el?.addEventListener("input", () => {
        const cleaned = el.value.replace(/\D/g, "");
        if (el.value !== cleaned) el.value = cleaned;
      });
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      formErr.hidden = true;

      if (!validate()) return;

      // Honeypot: a filled `website` means a bot. Take the success path so the bot
      // logs a win and moves on, but send nothing.
      if (byId("lf-website")?.value) {
        window.location.assign(thanks);
        return;
      }

      submit.dataset.busy = "true";
      submit.setAttribute("aria-busy", "true");
      submitLabel.textContent = submit.dataset.labelBusy ?? submitLabel.textContent;

      const payload = new FormData(form);
      payload.set("locale", form.dataset.locale ?? "mr");
      payload.set("source_page", form.dataset.source ?? "/");
      payload.set("submittedAt", new Date().toISOString());

      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: payload,
          headers: { Accept: "application/json" },
        });
        const data = await res.json().catch(() => null);

        if (res.ok && data?.ok) {
          window.location.assign(thanks);
          return;
        }

        // Server-side validation failed (or the response could not be parsed).
        // Map the canonical field names it returns back onto whichever fieldset is
        // currently visible.
        submit.dataset.busy = "false";
        submit.removeAttribute("aria-busy");
        submitLabel.textContent = submit.dataset.label ?? submitLabel.textContent;

        const audience = activeAudience();
        const fieldErrors = data?.errors as Record<string, string> | undefined;
        if (fieldErrors && audience) {
          let shown = false;
          for (const [key, text] of Object.entries(fieldErrors)) {
            if (key === "consent") {
              showError("err-consent", byId("lf-consent"), text);
              shown = true;
              continue;
            }
            if (key === "lead_type") {
              showError("err-lead_type", null, text);
              shown = true;
              continue;
            }
            const mapped = FIELD_MAP[audience]?.[key];
            if (mapped) {
              showError(mapped.err, byId(mapped.input.replace("[]", "")), text);
              shown = true;
            }
          }
          if (!shown) {
            formErr.textContent = msg.network;
            formErr.hidden = false;
          }
        } else {
          formErr.textContent = msg.network;
          formErr.hidden = false;
          formErr.scrollIntoView({ block: "center", behavior: "smooth" });
        }
      } catch {
        submit.dataset.busy = "false";
        submit.removeAttribute("aria-busy");
        submitLabel.textContent = submit.dataset.label ?? submitLabel.textContent;
        formErr.textContent = msg.network;
        formErr.hidden = false;
        formErr.scrollIntoView({ block: "center", behavior: "smooth" });
      }
    });
  }
</script>
