---
import Base from "../layouts/Base.astro";
import JsonLd from "./layout/JsonLd.astro";
import HeroPreload from "./layout/HeroPreload.astro";
import Hero from "./sections/Hero.astro";
import Stock from "./sections/Stock.astro";
import Products from "./sections/Products.astro";
import Dcr from "./sections/Dcr.astro";
import WhyUs from "./sections/WhyUs.astro";
import Process from "./sections/Process.astro";
import LeadForm from "./sections/LeadForm.astro";
import Faq from "./sections/Faq.astro";
import Contact from "./sections/Contact.astro";
import { useTranslations } from "../i18n/ui";
import { type Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Base
  locale={locale}
  title={t("meta.home.title")}
  description={t("meta.home.description")}
  path="/"
  floatingHeader
>
  <JsonLd slot="head" locale={locale} withFaq />
  <HeroPreload slot="head" />

  <Hero locale={locale} />
  <Stock locale={locale} />
  <Products locale={locale} />
  <Dcr locale={locale} />
  <WhyUs locale={locale} />
  <Process locale={locale} />
  <LeadForm locale={locale} />
  <Faq locale={locale} />
  <Contact locale={locale} />
</Base>
