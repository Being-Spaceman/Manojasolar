---
import Base from "../layouts/Base.astro";
import { useTranslations } from "../i18n/ui";
import { localePath, type Locale } from "../i18n/config";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  headline: string;
  noindex?: boolean;
  homeLabel: string;
}

const {
  locale,
  title,
  description,
  path,
  headline,
  noindex = false,
  homeLabel,
} = Astro.props;
const t = useTranslations(locale);
---

<Base
  locale={locale}
  title={title}
  description={description}
  path={path}
  noindex={noindex}
>
  <section class="simple">
    <div class="wrap inner">
      <h1 class="headline">{headline}</h1>
      <div class="prose">
        <slot />
      </div>
      <a class="home" href={localePath("/", locale)}>{homeLabel}</a>
    </div>
  </section>
</Base>

<style>
  .simple {
    background: #fff;
    padding-block: 40px 56px;
  }
  .inner {
    max-width: 44rem;
  }
  .headline {
    color: var(--color-forest);
    font-size: var(--text-h2);
    font-weight: 800;
    line-height: 1.35;
  }
  .prose {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 18px;
  }
  .prose :global(p) {
    color: var(--color-body);
    font-size: var(--text-base);
    line-height: 1.65;
  }
  .prose :global(h2) {
    color: var(--color-ink);
    font-size: var(--text-subhead);
    font-weight: 800;
    margin-top: 12px;
  }
  .prose :global(ul) {
    color: var(--color-body);
    display: flex;
    flex-direction: column;
    font-size: var(--text-base);
    gap: 8px;
    line-height: 1.6;
    margin: 0;
    padding-left: 20px;
  }
  .home {
    align-self: flex-start;
    box-shadow: inset 0 -1px 0 0 var(--color-field);
    color: var(--color-green);
    display: inline-block;
    font-weight: 600;
    margin-top: 26px;
  }
  @media (min-width: 64rem) {
    .simple {
      padding-block: 64px 88px;
    }
    .headline {
      font-size: var(--text-h1-lg);
    }
  }
</style>
