---
import { useTranslations } from "../../i18n/ui";
import { localePath, type Locale } from "../../i18n/config";
import LangToggle from "./LangToggle.astro";

interface Props {
  locale: Locale;
  path: string;
  /** Homepage only: floats translucent over the full-bleed hero, then
   *  switches to solid once Hero.astro's sentinel scrolls past (see the
   *  IntersectionObserver in Hero.astro's second inline script). */
  floating?: boolean;
}

const { locale, path, floating = false } = Astro.props;
const t = useTranslations(locale);

/*
  /home-solar is a different page with different sections, so the B2B
  anchor nav (#stock, #products, ...) does not resolve there. Rather than a
  second hardcoded nav array, the one meaningful link on that page is back
  to the trade site — everything else on this bar (wordmark, lang toggle)
  already works unchanged because it does not depend on in-page anchors.
*/
const onHomeSolar = path === "/home-solar" || path.startsWith("/home-solar/");

// Cut to four items — "Why us" reads in page flow with no nav entry, and
// "Questions" moved to a footer link. Home solar is rendered separately
// below so it reads as a distinct, secondary link rather than a nav peer.
const nav = onHomeSolar
  ? [{ key: "homeSolar.backToTrade", href: localePath("/", locale) }]
  : [
      { key: "nav.stock", href: "#stock" },
      { key: "nav.products", href: "#products" },
      { key: "nav.process", href: "#process" },
      { key: "nav.contact", href: "#contact" },
    ];
---

<header class:list={["hdr", { floating }]} data-floating-header={floating || undefined}>
  <div class="hdr-inner wrap">
    {/*
      Logo slot. The identity's stacked lockup: म tile + Devanagari name leading,
      Latin name underneath as the legal line. Set in type, not an image file —
      it is three text nodes and costs nothing, and it stays crisp at any density.
    */}
    {/* No aria-label: the tile is aria-hidden, so the accessible name falls out of
        the two name spans. An aria-label naming only the Devanagari would fail
        WCAG 2.5.3 against the visible Latin line underneath it. */}
    <a href={localePath("/", locale)} class="lockup">
      <span class="tile" aria-hidden="true">म</span>
      <span class="names">
        <span class="name-deva" lang="mr">{t("site.name")}</span>
        <span class="name-latin">{t("site.nameLatin")}</span>
      </span>
    </a>

    <nav class="nav" aria-label={t("nav.menuOpen")}>
      {nav.map((item) => <a href={item.href}>{t(item.key)}</a>)}
      {!onHomeSolar && (
        <a href={localePath("/home-solar", locale)} class="nav-home-solar">
          {t("nav.homeSolar")}
        </a>
      )}
    </nav>

    <LangToggle locale={locale} path={path} tone="light" />
  </div>
</header>

<style>
  .hdr {
    background: var(--color-green);
    color: #fff;
    /* Sticky, not fixed: it participates in normal flow until scrolled past, so
       it never overlaps the hero on first paint or needs a manual body-padding
       offset the way a fixed bar would. */
    position: sticky;
    top: 0;
    z-index: 50;
  }

  /* Detached, translucent overlay while the full-bleed hero is in view.
     Fixed (not sticky) with a small inset so it visibly floats rather than
     sitting flush — square corners throughout, never a pill. Goes solid via
     .is-solid once Hero.astro's IntersectionObserver reports the hero has
     scrolled past, so nav text keeps its contrast over whatever content
     follows instead of staying translucent over a light section. */
  .hdr.floating {
    background: rgb(11 31 23 / 0.55);
    inset-inline: 12px;
    position: fixed;
    top: 12px;
    transition: background 0.2s ease-out;
  }
  .hdr.floating.is-solid {
    background: var(--color-ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .hdr.floating {
      transition: none;
    }
  }

  .hdr-inner {
    align-items: center;
    display: flex;
    gap: 10px;
    justify-content: space-between;
    min-height: 56px;
    padding-block: 10px;
  }

  .lockup {
    align-items: center;
    display: flex;
    gap: 9px;
    /* min-width:0 lets the name shrink so it can never shove the language toggle
       off the bar. Truncation happens on the two text spans themselves — clipping
       it here as well would cut the tops off the Devanagari matras. */
    min-width: 0;
  }

  /* The म tile — hard square, never rounded outside app-icon contexts. */
  .tile {
    background: #fff;
    color: var(--color-green);
    display: grid;
    flex: none;
    font-size: 20px;
    font-weight: 800;
    height: 28px;
    place-items: center;
    width: 28px;
  }

  .names {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .name-deva {
    color: #fff;
    font-size: 16px;
    font-weight: 800;
    /* 1.6, not the 1.25 a Latin wordmark would take. Mukta's Devanagari metrics ask
       for roughly 1.6em of line box — a matra above the शिरोरेखा and a vowel sign
       below the baseline — and this span truncates with overflow:hidden, so any
       leading tighter than the font's own metrics crops the glyphs rather than
       merely letting them breathe outside the line box. */
    line-height: 1.6;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Latin caps are tracked so the line length matches the Devanagari above it.
     This width relationship IS the lockup (Identity §04). */
  .name-latin {
    /* 0.92, not 0.8. White on Waaree Green tops out at 5.39:1, so there is very
       little headroom to fade: 0.8 measures 4.04:1 and fails AA at this size. */
    color: rgb(255 255 255 / 0.92);
    font-size: 7.5px;
    font-weight: 600;
    letter-spacing: 0.2em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Anchor nav is desktop-only: on a phone the whole page is one scroll and the
     sticky CTA bar is the navigation that matters. */
  .nav {
    display: none;
  }

  @media (min-width: 64rem) {
    .hdr-inner {
      min-height: 64px;
    }
    .tile {
      font-size: 22px;
      height: 32px;
      width: 32px;
    }
    .name-deva {
      font-size: 19px;
    }
    .name-latin {
      font-size: 9px;
    }
    .nav {
      display: flex;
      flex: 1;
      gap: 24px;
      justify-content: flex-end;
      margin-inline-end: 8px;
    }
    .nav a {
      color: rgb(255 255 255 / 0.92);
      font-size: var(--text-base);
      font-weight: 600;
      padding-block: 6px;
    }
    .nav a:hover {
      color: #fff;
      box-shadow: inset 0 -2px 0 0 #fff;
    }
    /* Home solar addresses a different audience — set apart from the trade
       nav items rather than reading as a peer of Stock/Products/etc. */
    .nav-home-solar {
      border-left: 1px solid rgb(255 255 255 / 0.3);
      color: rgb(255 255 255 / 0.75) !important;
      font-style: italic;
      margin-inline-start: 4px;
      padding-inline-start: 20px !important;
    }
  }
</style>
