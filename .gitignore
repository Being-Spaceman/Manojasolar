.env
.env.*
!.env.example
server/config.php
server/archive/*.xlsx

# lighthouse + audit output
lighthouse/
*.report.html
*.report.json

# editors
.vscode/
.idea/
*.swp

# os
.DS_Store
Thumbs.db
desktop.ini

# design source — reference only, not part of the build.
